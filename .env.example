POSTGRES_DB=number_theory
POSTGRES_USER=number_theory
POSTGRES_PASSWORD=number_theory_dev
DATABASE_URL=postgresql://number_theory:number_theory_dev@db:5432/number_theory
PDF_ROOT=/data/pdf
CORS_ORIGINS=http://localhost:3000

# 从 https://platform.openai.com/api-keys 创建。不要提交真实密钥。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 仅在使用代理或兼容网关时填写；官方 API 请留空。
OPENAI_BASE_URL=
VERIFIER_TIMEOUT=70
LEAN_TIMEOUT=60
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 1 = 每次启动按部署清单检查并补全缺失章节（默认开启，需 OPENAI_API_KEY）
AUTO_INGEST_MANIFEST=1
# 逗号分隔覆盖清单，例如 profile:hill-ch1,book:cai（留空则用 ingestion/manifest.py）
DEPLOY_INGEST_TARGETS=
# 仅当库完全为空时全量入库全部书目（一般不需要）
INGEST_IF_EMPTY=0
