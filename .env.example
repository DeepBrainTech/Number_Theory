POSTGRES_DB=number_theory
POSTGRES_USER=number_theory
POSTGRES_PASSWORD=number_theory_dev
DATABASE_URL=postgresql://number_theory:number_theory_dev@db:5432/number_theory
# Local + production frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://proof-lab.deepbrainacademy.org

# From https://platform.openai.com/api-keys — never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Only for a proxy / compatible gateway; leave empty for the official API.
OPENAI_BASE_URL=
VERIFIER_TIMEOUT=70
LEAN_TIMEOUT=60
NEXT_PUBLIC_API_BASE_URL=
# Google Sign-In (same Client ID on backend + frontend).
# Authorized JS origins: http://localhost:3000 and https://proof-lab.deepbrainacademy.org
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
SESSION_SECRET=dev-insecure-session-secret-change-me
# Set COOKIE_SECURE=1 in production (HTTPS)
COOKIE_SECURE=0
# Auto Prove artifact directory (default inside container: /data/auto_prove_runs)
AUTO_PROVE_RUNS_DIR=/data/auto_prove_runs
